# Supabase project (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the Claude-powered AI routes (/api/ai/*).
# Get one from https://console.anthropic.com/settings/keys
# Never expose this to the client - it is only read in app/api/ai/* route handlers.
ANTHROPIC_API_KEY=
